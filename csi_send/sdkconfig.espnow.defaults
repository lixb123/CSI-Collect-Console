# Dedicated ESP-NOW research transmitter profile. The normal SoftAP defaults
# remain unchanged for Router Ping compatibility.
CONFIG_RESEARCH_TX_SOFTAP_MODE=n
CONFIG_RESEARCH_TX_EXPERIMENT_ID="UNSET"
CONFIG_RESEARCH_TX_SEND_INTERVAL_MS=10
CONFIG_RESEARCH_TX_PAYLOAD_LENGTH=32
CONFIG_RESEARCH_TX_CHANNEL=11
CONFIG_RESEARCH_TX_AUTOSTART=y
